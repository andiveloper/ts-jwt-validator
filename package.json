{
  "name": "ts-jwt-validator",
  "version": "1.0.7",
  "description": "This library can be used to validate JWT tokens and signatures easily by providing a Open ID JWKS URI which hosts the public keys, e.g. for use with Azure AD B2C or auth0.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "readme": "README.md",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint \"**/*.ts\"",
    "pretest": "npm run build && npm run lint",
    "test": "jest --verbose --no-cache",
    "prepublish": "npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andiveloper/ts-jwt-validator.git"
  },
  "keywords": [
    "azure",
    "auth",
    "openid",
    "jwt"
  ],
  "author": "Andreas Koeninger",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andiveloper/ts-jwt-validator/issues"
  },
  "homepage": "https://github.com/andiveloper/ts-jwt-validator#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1"
  },
  "files": [
    "lib/**/*"
  ],
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
